@startuml c4_level3_component_backend
!include <c4/C4_Component.puml>

LAYOUT_WITH_LEGEND()

title C4-3 Component Diagram

Container_Boundary(backend, "Backend (Java / Javalin)") {

    Component(api, "REST-API", "JSON", "öffentliche Endpunkte für User, WG, Shoppinglists, Items")

    Component(sessionMgr, "Session-Manager","Authentifizierung & Sessionmanagement","Verwaltung Login & Session")

    Component(userMgr, "UserManager","User-Logik","Verwaltung von Benutzern und Benutzerzugriffen")

    Component(wgMgr, "WGManager","WG-Logik","Verwaltung von WGs und WG-Mitgliedschaften")

    Component(listMgr, "ShoppingList Manager","Listen-Logik","Verwaltung von Einkaufslisten")

    Component(itemMgr, "ItemManager","Item-Logik","Verwaltung von Items")
}

ContainerDb(db, "Database", "PostgreSQL")

Rel(api, sessionMgr, "validiert")
Rel(api, userMgr, "ruft auf")
Rel(api, wgMgr, "ruft auf")
Rel(api, listMgr, "ruft auf")
Rel(api, itemMgr, "ruft auf")

Rel(sessionMgr, userMgr, "löst User anhand Session auf")
Rel(listMgr, wgMgr, "gehört zu WG")
Rel(itemMgr, listMgr, "gehört zu Liste")

Rel(userMgr, db, "liest/schreibt")
Rel(wgMgr, db, "liest/schreibt")
Rel(listMgr, db, "liest/schreibt")
Rel(itemMgr, db, "liest/schreibt")

@enduml
