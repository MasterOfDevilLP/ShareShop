@startuml c4_level3_components_frontend
!include <c4/C4_Component.puml>

LAYOUT_WITH_LEGEND()

title C4-3 Component Diagram – Frontend

Container_Boundary(frontend, "Frontend (PWA / Vue im Browser)") {

    Component(loginUI, "Login UI", "Login/auth.js","Login, Authentifizierung, Redirect nach erfolgreichem Login")

    Component(startUI, "Startseite UI", "Startseitendesign/app.js","WG-Auswahl, Listenübersicht, Navigation zu Einkaufslisten")

    Component(listUI, "Einkaufsliste UI", "Einkaufsliste/app.js","Anzeige und Bearbeitung von Einkaufslisten und Items")

    Component(inviteUI, "Invite UI", "invite/invite.js","Beitritt zu WG über Invite-Link")

    Component(logoutUI, "Logout UI", "Logout/logout.js","Logout, Löschen lokaler Daten, Redirect")

    Component(apiConfig, "API Konfiguration", "config.js / config-docker.js","Definition der Backend-Basis-URL")

    Component(httpClient, "HTTP Client", "fetch API","Kommunikation mit dem Backend über JSON/HTTP(S)")

    Component(localStore, "Local Storage", "window.localStorage","Speichert Session- und UI-Zustand (z. B. WG-ID, Listen-ID)")
}

System_Ext(backend, "Backend (Java)", "REST API")

' --- Nutzung gemeinsamer Infrastruktur ---
Rel(loginUI, apiConfig, "nutzt")
Rel(startUI, apiConfig, "nutzt")
Rel(listUI, apiConfig, "nutzt")
Rel(inviteUI, apiConfig, "nutzt")
Rel(logoutUI, apiConfig, "nutzt")

Rel(loginUI, httpClient, "ruft Backend auf")
Rel(startUI, httpClient, "ruft Backend auf")
Rel(listUI, httpClient, "ruft Backend auf")
Rel(inviteUI, httpClient, "ruft Backend auf")
Rel(logoutUI, httpClient, "ruft Backend auf (optional)")

Rel(httpClient, backend, "JSON/HTTP(S)")

Rel(loginUI, localStore, "liest/schreibt", "Login-Status, Redirect-Info")
Rel(startUI, localStore, "liest/schreibt", "WG-Auswahl")
Rel(listUI, localStore, "liest/schreibt", "Listen-/WG-ID")
Rel(inviteUI, localStore, "liest/schreibt", "Invite-Status")
Rel(logoutUI, localStore, "löscht", "Session-Daten")

@enduml
