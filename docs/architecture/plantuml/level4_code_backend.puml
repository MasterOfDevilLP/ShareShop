@startuml c4_level4_code_backend
title C4-4 Code (Beispiel): Backend Klassenstruktur

skinparam classAttributeIconSize 0

package "http" {
  class AuthMiddleware {
    +handle(request): UserContext
  }

  class UserController {
    +register()
    +getMe()
  }

  class WGController {
    +createWG()
    +getMyWGs()
    +addMember()
  }

  class ShoppingListController {
    +createList()
    +getLists()
    +renameList()
    +deleteList()
  }

  class ItemController {
    +addItem()
    +toggleBought()
    +searchItems()
    +removeItem()
  }
}

package "service" {
  class UserService {
    +createUser(email, password)
    +findById(userId)
  }

  class SessionService {
    +login(email, password): Session
    +validate(token): UserContext
    +logout(token)
  }

  class WGService {
    +createWG(ownerId, name): WG
    +getWGsForUser(userId)
    +checkMembership(userId, wgId)
    +addMember(wgId, userId)
  }

  class ShoppingListService {
    +createList(wgId, name): ShoppingList
    +getLists(wgId)
    +renameList(listId, name)
    +deleteList(listId)
  }

  class ItemService {
    +addItem(listId, name, qty): Item
    +toggleBought(itemId)
    +search(wgId, query)
    +removeItem(itemId)
  }
}

package "domain" {
  class User {
    +id: UUID
    +email: String
    +passwordHash: String
  }

  class Session {
    +token: String
    +userId: UUID
    +expiresAt: Instant
  }

  class WG {
    +id: UUID
    +name: String
  }

  class ShoppingList {
    +id: UUID
    +wgId: UUID
    +name: String
  }

  class Item {
    +id: UUID
    +listId: UUID
    +name: String
    +quantity: int
    +bought: boolean
  }
}

package "persistence" {
  interface UserRepository {
    +save(user)
    +findById(id)
    +findByEmail(email)
  }

  interface SessionRepository {
    +save(session)
    +findByToken(token)
    +deleteByToken(token)
  }

  interface WGRepository {
    +save(wg)
    +findById(id)
    +findForUser(userId)
    +addMember(wgId, userId)
    +isMember(wgId, userId): boolean
  }

  interface ShoppingListRepository {
    +save(list)
    +findByWG(wgId)
    +findById(id)
    +delete(id)
  }

  interface ItemRepository {
    +save(item)
    +findByList(listId)
    +findById(id)
    +searchInWG(wgId, query)
    +delete(id)
  }
}

' HTTP -> Service
AuthMiddleware --> SessionService
UserController --> UserService
UserController --> SessionService
WGController --> WGService
ShoppingListController --> ShoppingListService
ItemController --> ItemService

' Services -> Repos
UserService --> UserRepository
SessionService --> SessionRepository
WGService --> WGRepository
ShoppingListService --> ShoppingListRepository
ItemService --> ItemRepository
ItemService --> WGRepository : "search scope"
ShoppingListService --> WGRepository : "membership check"

' Domain relations
WG "1" o-- "0..*" ShoppingList
ShoppingList "1" o-- "0..*" Item

Session "*" --> "1" User : userId

@enduml
